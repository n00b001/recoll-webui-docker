# =============================================================================
# mbsync Configuration — IMAP → Maildir Sync (TEMPLATE)
# =============================================================================
# This file is rendered at container startup via envsubst.
# All ${VAR} references are replaced with environment variable values.
#
# Image: custom mbsync wrapper (FROM ghcr.io/jakewharton/mbsync)
# Config rendered by entrypoint.sh → /config/mbsync.rc
# Data:   app-data/mbsync/data/   → /mail (Maildir tree)
#
# Four mailboxes:
#   Alex:  alex-gmail (Gmail IMAP), alex-imap (generic IMAP)
#   Chloe: chloe-outlook (Outlook.com IMAP), chloe-imap (generic IMAP)
#
# Passwords: PassCmd pulls from container env — never stored in this file.
# =============================================================================

# ------------------------- Alex — Gmail IMAP --------------------------------
IMAPAccount alex-gmail
    Host ${IMAP_HOST_ALEX_GMAIL}
    Port ${IMAP_PORT_ALEX_GMAIL:-993}
    User ${IMAP_USER_ALEX_GMAIL}
    PassCmd "printenv IMAP_PASS_ALEX_GMAIL"
    AuthMechs LOGIN
    SSLType IMAPS
    PipelineDepth 50

IMAPStore alex-gmail-remote
    Account alex-gmail

MaildirStore alex-gmail-local
    Path /mail/alex-gmail/
    Inbox /mail/alex-gmail/INBOX
    SubFolders Verbatim

Channel alex-gmail-channel
    Far :alex-gmail-remote:
    Near :alex-gmail-local:
    Patterns INBOX INBOX.*
    Sync Pull
    Create Near
    Expunge Near
    SyncState *

