# =============================================================================
# Environment Variables — Unified Search Infrastructure
# Copy to .env and fill in secure passwords and paths.
# All variables have defaults via :- in docker-compose.yml;
# override here only when you need different values.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. TrueNAS / Host Path Configuration
# Edit these to match your TrueNAS dataset mount points.
# ---------------------------------------------------------------------------
# Base share path (where all data lives)
SHUTTLE_PATH=/mnt/shuttle/share

# App data root
APP_DATA_PATH=${SHUTTLE_PATH}/app-data

# Syncthing dataset
SYNCTHING_PATH=${SHUTTLE_PATH}/syncthing

# Per-user home datasets
ALEX_HOME_PATH=${SHUTTLE_PATH}/alex-home
CHLOE_HOME_PATH=${SHUTTLE_PATH}/chloe-home

# Derived paths (usually don't need to change these)
# Recoll index data
RECOLL_DATA_PATH=${APP_DATA_PATH}/recoll

# Immich data
IMMICH_DATA_PATH=${APP_DATA_PATH}/immich

# mbsync config and Maildir data
MBSYNC_CONFIG_PATH=${APP_DATA_PATH}/mbsync/config
MBSYNC_DATA_PATH=${APP_DATA_PATH}/mbsync/data

# WhatsApp config (Baileys sessions) and exports
WHATSAPP_CONFIG_PATH=${APP_DATA_PATH}/whatsapp/config
WHATSAPP_DATA_PATH=${APP_DATA_PATH}/whatsapp/data

# SMS processor output
SMS_DATA_PATH=${APP_DATA_PATH}/sms-organized

# Syncthing sub-paths
ALEX_HADDES_PATH=${SYNCTHING_PATH}/alex-hades-home
ALEX_PHONE_PATH=${SYNCTHING_PATH}/alex-phone
CHLOE_HOME_SYNC_PATH=${SYNCTHING_PATH}/chloe-home
CHLOE_PHONE_PATH=${SYNCTHING_PATH}/chloe-phone

# Google Drive / Photos (under per-user homes)
ALEX_GDRIVE_PATH=${ALEX_HOME_PATH}/google-drive
ALEX_GPHOTOS_PATH=${ALEX_HOME_PATH}/google-photos
CHLOE_GDRIVE_PATH=${CHLOE_HOME_PATH}/google-drive
CHLOE_GPHOTOS_PATH=${CHLOE_HOME_PATH}/google-photos

# ---------------------------------------------------------------------------
# 2. Email Accounts (mbsync — IMAP → Maildir)
# ---------------------------------------------------------------------------
# mbsync does NOT expand ${VAR} in mbsyncrc, so usernames + hostnames are
# baked into mbsync/mbsyncrc literally. The var list below is a reference:
# edit mbsync/mbsyncrc if you change a username or host.
#
# Passwords ARE read at sync time via PassCmd "printenv <VAR>" — secrets stay
# in the container env, never in the config file or /proc/<pid>/cmdline.
# Gmail + Outlook.com require app-specific passwords.

# 2a. Reference — bake these into mbsync/mbsyncrc
# IMAP_USER_ALEX_GMAIL=alex@gmail.com          Host imap.gmail.com            Port 993
# IMAP_USER_ALEX_IMAP=alex@example.com          Host mail.example.com          Port 993
# IMAP_USER_CHLOE_OUTLOOK=chloe@outlook.com     Host outlook.office365.com     Port 993
# IMAP_USER_CHLOE_IMAP=chloe@example.com        Host mail.example.com          Port 993

# IMAP host (used when configuring email accounts; defaults to imap.gmail.com)
# Set per-account hosts in mbsync/mbsyncrc — mbsync does not expand ${VAR}.
# IMAP_HOST=imap.gmail.com

# IMAP host port (used when configuring email accounts; defaults to 993 for IMAPS)
IMAP_HOST_PORT=993

# 2b. Passwords (passed to container as env vars; consumed by PassCmd)
IMAP_PASS_ALEX_GMAIL=<generate-secure-app-password>
IMAP_PASS_ALEX_IMAP=<generate-secure-password>
IMAP_PASS_CHLOE_OUTLOOK=<generate-secure-app-password>
IMAP_PASS_CHLOE_IMAP=<generate-secure-password>

# 2c. Optional mbsync behaviour (PUID/PGID for file ownership)
# MBSYNC_PUID=1000
# MBSYNC_PGID=1000

# ---------------------------------------------------------------------------
# 3. WhatsApp Archiver (one container per account: alex + chloe)
# ---------------------------------------------------------------------------
WHATSAPP_ACCOUNT_ALEX=alex
WHATSAPP_ACCOUNT_CHLOE=chloe
WHATSAPP_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 4. Immich (PostgreSQL + Redis)
# ---------------------------------------------------------------------------
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=<generate-secure-password>
IMMICH_DB_NAME=immich
IMMICH_REDIS_PASSWORD=<generate-secure-password>

# ---------------------------------------------------------------------------
# 5. SMS / RCS Processor
# ---------------------------------------------------------------------------
SMS_POLL_INTERVAL=300

# ---------------------------------------------------------------------------
# 6. Audio / Video Transcription (recoll-audio-worker — whisper.cpp)
# ---------------------------------------------------------------------------
AUDIO_POLL_INTERVAL=300
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto
